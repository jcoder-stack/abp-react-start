{
  "name": "@jcoder-stack/cli",
  "description": "The jc-abp CLI: gen (react-query client generation via an orval preset), add (copy registry shells in), and init (one-stop project setup)",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcoder-stack/abp-react-start.git",
    "directory": "packages/cli"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "jc-abp": "./bin/jc-abp.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "orval": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "prepublishOnly": "npm exec --no -- tsup --config ../../tsup.config.ts",
    "prepack": "node ../../scripts/apply-publish-config.mjs",
    "postpack": "node ../../scripts/restore-publish-config.mjs"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
