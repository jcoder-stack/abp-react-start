        "[data-slot=\"rich-text-content\"] .hljs-number, [data-slot=\"rich-text-content\"] .hljs-literal, [data-slot=\"rich-text-content\"] .hljs-symbol, [data-slot=\"rich-text-content\"] .hljs-bullet": {
          "color": "var(--rte-text-orange)"
