          "float": "left",
          "height": "0",
          "pointer-events": "none",
          "color": "var(--muted-foreground)"
        },
        "[data-slot=\"rich-text-content\"] :not(pre) > code": {
          "background-color": "var(--muted)",
          "border-radius": "0.25rem",
          "padding": "0.125rem 0.25rem",
          "font-weight": "400"
        },
        "[data-slot=\"rich-text-content\"] :not(pre) > code::before, [data-slot=\"rich-text-content\"] :not(pre) > code::after": {
          "content": "none"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"]": {
          "list-style": "none",
          "padding-left": "0.25rem"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"] li": {
          "display": "flex",
          "align-items": "flex-start",
          "gap": "0.5rem",
          "padding-left": "0"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"] li > label": {
          "flex": "none",
          "margin-top": "0.25em",
          "user-select": "none"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"] li > label input": {
          "accent-color": "var(--primary)"
        },
