          "flex": "1 1 auto",
          "min-width": "0"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"] li > div > p": {
          "margin": "0"
        },
        "[data-slot=\"rich-text-content\"] ul[data-type=\"taskList\"] li[data-checked=\"true\"] > div": {
          "color": "var(--muted-foreground)",
          "text-decoration": "line-through"
        },
        "[data-slot=\"rich-text-content\"] .tableWrapper": {
          "overflow-x": "auto"
        },
        "[data-slot=\"rich-text-content\"] table": {
          "table-layout": "fixed",
          "width": "100%",
          "border-collapse": "collapse"
        },
        "[data-slot=\"rich-text-content\"] th, [data-slot=\"rich-text-content\"] td": {
          "position": "relative",
          "border": "1px solid var(--border)",
          "padding": "0.375rem 0.5rem",
          "vertical-align": "top"
        },
        "[data-slot=\"rich-text-content\"] th": {
          "background-color": "var(--muted)",
          "text-align": "left"
        },
        "[data-slot=\"rich-text-content\"] th > p, [data-slot=\"rich-text-content\"] td > p": {
          "margin": "0"
        },
        "[data-slot=\"rich-text-content\"] .selectedCell::after": {
          "content": "\"\"",
          "position": "absolute",
          "inset": "0",
          "pointer-events": "none",
          "background-color": "color-mix(in oklch, var(--primary) 12%, transparent)"
        },
        "[data-slot=\"rich-text-content\"] img": {
          "max-width": "100%",
          "height": "auto",
          "border-radius": "0.375rem"
        },
        "[data-slot=\"rich-text-content\"] .ProseMirror-selectednode": {
          "outline": "2px solid var(--ring)",
          "outline-offset": "2px"
        },
        "[data-slot=\"rich-text-content\"] [data-type=\"mention\"]": {
          "border-radius": "0.25rem",
          "padding": "0 0.125rem",
          "color": "var(--primary)",
          "background-color": "color-mix(in oklch, var(--primary) 10%, transparent)"
        },
        "[data-slot=\"rich-text-content\"] .hljs-comment, [data-slot=\"rich-text-content\"] .hljs-quote": {
          "color": "var(--muted-foreground)",
          "font-style": "italic"
        },
        "[data-slot=\"rich-text-content\"] .hljs-keyword, [data-slot=\"rich-text-content\"] .hljs-selector-tag, [data-slot=\"rich-text-content\"] .hljs-built_in, [data-slot=\"rich-text-content\"] .hljs-type": {
          "color": "var(--rte-text-purple)"
