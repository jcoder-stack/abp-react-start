{
  "name": "@jcoder-stack/registry",
  "description": "Copy-in sources for the auth shell and shadcn blocks: login/callback/logout handlers, the callAbp proxy, route guards, and TanStack wiring",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "auth",
    "public/r"
  ],
  "scripts": {
    "build:registry": "node scripts/check-registry-deps.mjs && npx shadcn@latest build",
    "check-registry-deps": "node scripts/check-registry-deps.mjs",
    "prepack": "node ../scripts/apply-publish-config.mjs",
    "postpack": "node ../scripts/restore-publish-config.mjs"
  },
  "dependencies": {
    "@jcoder-stack/abp-react": "^0.1.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "9.0.0-beta.59",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.6.4",
    "sonner": "^2.0.7",
    "vite": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcoder-stack/abp-react-start.git",
    "directory": "registry"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
