{
  "name": "abp-react-start",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "registry"
  ],
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc -b packages/*/tsconfig.json registry/tsconfig.json registry/tsconfig.ui.json examples/starter/tsconfig.json --pretty false && tsc --noEmit -p packages/cli/tsconfig.templates.json --pretty false && tsc --noEmit -p packages/abp-react/tsconfig.typetest.json --pretty false",
    "build": "bun run --filter './packages/*' build",
    "build:registry": "bun run --filter ./registry build:registry",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
